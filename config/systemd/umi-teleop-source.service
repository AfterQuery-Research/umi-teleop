[Unit]
Description=UMI dual-Vive + ArUco source for bimanual YAM teleoperation
After=network-online.target
Wants=network-online.target
Conflicts=umi-yam-teleop-source.service umi-pi-recorder.service umi-vive-receiver.service umi-buttons.service

[Service]
Type=simple
User=aq
SupplementaryGroups=video dialout
Environment=GPIOZERO_PIN_FACTORY=lgpio
WorkingDirectory=/home/aq/umi-teleop
ExecStartPre=/usr/bin/test -x /home/aq/umi-teleop/.venv/bin/umi-source
ExecStart=/home/aq/umi-teleop/.venv/bin/umi-source \
    --target-host 10.103.2.152 --target-port 9140
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
