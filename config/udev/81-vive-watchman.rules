# Vive Tracker Watchman wireless receivers. This grants access but starts no process.
SUBSYSTEM=="usb", ATTR{idVendor}=="28de", ATTR{idProduct}=="2101", GROUP="plugdev", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="28de", ATTRS{idProduct}=="2101", GROUP="plugdev", MODE="0660", TAG+="uaccess"
